#
# Metadata
#
.vagrant
.vscode
__pycache__
.Trash-1001

#
# Build Files
#
build
*.gcov
*.o
support/nos3_install.log
tmp
core.*
pic.jpg
cam.jpg

#
# Misc
#
*.pcapng
.cdskeyfile
.reservedkeyfile
.resetkeyfile

#
# Documentation
#
docs/coverage/coverage_report.*
docs/wiki/_build
docs/wiki/_templates
*.bkp
# NOTE: do NOT add a blanket `*.html` rule here. The standalone demo apps in app/
# are version-controlled deliverables: sparta_coverage.html is a hand-authored
# HTML/CSS base whose inlined NOS3 overlay block is regenerated by
# app/build_overlay.py, and ics_standalone.html is a hand-authored matrix.
# Generated HTML that genuinely needs ignoring is scoped by path above
# (docs/coverage, docs/wiki/_build); everything else lives in submodules, which
# this file does not govern.

#
# Tooling / dev environment
#
.claude
.playwright-mcp
logs

#
# SPARTA attack-script catalog — a separate side-project that leverages NOS3 +
# OnAIR but is versioned independently, NOT part of the base nos3 repo. Left at
# this path because run_attack.py resolves scripts here (ATTACK_SCRIPTS_ROOT).
#
gsw/attack_scripts/

#
# AI anomaly detection — derived/runtime artifacts
#
data/onair/models/*.pkl
data/onair/models/*.calibration.json
data/onair/scenarios/*.log
data/onair/scenarios/*_dryrun*.json
# Training corpus written by the OnAIR csv_output plugin. Configured in
# components/onair/nos3_security.ini OutputDir to land here (outside fsw/build/)
# so the data survives a clean rebuild.
data/onair/csv/
# Frozen v3 corpus: a pinned selection of csv_out_* files, implemented as
# symlinks into data/onair/csv/ (kept as symlinks — no data duplication). The
# symlink targets are already ignored, so committing these pointers is pointless.
data/onair/csv_corpus_v3stage/
# AINOS3-30 staged collection corpus (fresh 256-col instance, ~179M) — data, not tracked.
data/onair/csv_ainos3_30/
# AINOS3-30 Sprint-27 weak-class corpus (359-col, ~170M): symlinks into
# data/onair/csv/ plus copied manifests. Targets are already ignored, so the
# pointers are pointless to commit — same rule as csv_corpus_v3stage/.
data/onair/csv_ainos3_30_s27/
data/onair/scenarios_ainos3_30_s27/
# De-interleaved corpus (AINOS3-125): one coherent stream rebuilt from the SBN
# double buffer by deinterleave_csv.py. Derived from data/onair/csv/ — regenerable
# from it at any time, and the sources are already ignored.
data/onair/csv_blended/
# Idle-logging archive (AINOS3-97): sessions recorded with the stack left running
# and nothing being exercised. Moved out of data/onair/csv/ so a collection or
# training glob cannot pick them up. Data, not tracked — but the README and
# archive_manifest.json record what is in there and why.
data/onair/csv_idle_archive/*
!data/onair/csv_idle_archive/README.md
!data/onair/csv_idle_archive/archive_manifest.json
# Per-instance corpus views: symlink farms into data/onair/csv/ and csv_blended/.
# Same rule as csv_corpus_v3stage — the targets are ignored, so the pointers are
# pointless to commit. Rebuilt on demand from the corpus manifest.
data/onair/corpus/*/views/
data/onair/corpus/*/views_blended/
# Sprint-29 evaluation outputs (AINOS3-101/125). Same rule as the rest of
# data/onair/models: the small result JSONs are the record and are tracked; the
# feature caches, fold checkpoints and prediction dumps are regenerable bulk
# (~5 GB) and are not.
data/onair/models/rebuild29/**/*.npy
data/onair/models/rebuild29/**/*.npz
data/onair/models/rebuild29/**/*.pkl
data/onair/models/rebuild29/**/*.ini
# Hand-built reference file used to verify the de-interleave logic (AINOS3-125).
data/onair/csv_out_*.csv
data/onair/batch_*_results.json
# Third-party datasets fetched for benchmarking (AINOS3-82: CuCD-ID, CC BY 4.0,
# Mendeley 10.17632/7n2d42pm3n.3). Redistributable but not ours to vendor;
# benchmark_fayyaz.py re-downloads or takes --data-dir.
data/onair/external/
# SPARTA reference material fetched from https://sparta.aerospace.org/related-work/iob
# (Space Vehicle Logging Best Practices guide + spreadsheet, Distro A). Aerospace
# Corporation's to distribute, not ours to vendor — re-download from the IOB page.
# EXCEPT the .meta.json provenance sidecars, which are OURS: pure metadata (URL,
# fetch time, sha256, object counts) with no Aerospace content. They are what makes
# `fetch_sparta_stix.py --check` meaningful across machines and time — without them
# in git, every STIX claim in AINOS3-95/96/115/116/117/118 traces to an untracked
# local file fetched from a moving `f=latest` endpoint. (AINOS3-96, 2026-08-28)
data/sparta/*
!data/sparta/*.meta.json
# data/onair is data (NAS-backed) → git-ignored, EXCEPT the small deployed-config
# JSONs in models/ which are committed explicitly (cluster_taxonomy.json,
# incident_rescore*.json, explanation_catalog.json, *_report.md).
data/onair/scenarios/
data/onair/soak_logs/
data/onair/models/**/*.npz
data/onair/models/**/*.log
data/onair/models/**/confusion_*.csv
# SPARTA attack-script per-run logs land in CWD by default
ex_*_log_*.csv
demo_*_log_*.csv
imp_*_log_*.csv
de_*_log_*.csv
ia_*_log_*.csv
per_*_log_*.csv
rec_*_log_*.csv

# AINOS3-122 AC7 interim regeneration — staging, superseded by the AINOS3-101 deploy
data/onair/models/label_set_regen/

# Data artifacts (corpus CSVs, per-run results/logs, manifests, models, sweeps,
# backups) are NOT tracked — they bloat history and are regenerated by the
# collection tooling. Provenance lives in the tickets/plan, not in git blobs.
data/
